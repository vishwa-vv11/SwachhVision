# Keep the legacy portal front-end assets out of GitHub language statistics
# so the repo reflects the Python/FastAPI backend as the primary implementation.
frontend/**/*.html linguist-vendored
frontend/**/*.css linguist-vendored
frontend/**/*.js linguist-vendored
frontend/**/*.jsx linguist-vendored
frontend/**/*.ts linguist-vendored
frontend/**/*.tsx linguist-vendored
frontend/**/*.json linguist-vendored
frontend/**/*.svg linguist-vendored

# Keep docs under documentation reporting instead of code-language weighting.
docs/** linguist-documentation
